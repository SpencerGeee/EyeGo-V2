<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <!-- The driver app's deep navy. Fixed rather than themed: a widget sits on
       the user's wallpaper, not on our background, so it must be legible on
       anything rather than following the app's light/dark state. -->
  <solid android:color="#0E1A2B" />
  <corners android:radius="24dp" />
  <stroke android:width="1dp" android:color="#1F3350" />
</shape>
