# ─────────────────────────────────────────
# EyeGo admin console (apps/admin)
#
# Note what is NOT here: no NEXT_PUBLIC_ variable holds a credential, because
# every read runs in a server component and every write in a Server Action. The
# admin bearer token is carried in an httpOnly cookie and never reaches browser
# JavaScript. Never add a NEXT_PUBLIC_ variable containing a secret — Next
# inlines those into the client bundle at build time.
# ─────────────────────────────────────────

# Base URL of eyego-api, WITHOUT the /v1 suffix. The console appends /v1/admin.
# Server-to-server, so localhost works in dev and CORS never applies.
EYEGO_API_URL=http://localhost:5020

# Optional dev-only escape hatch: the API's legacy shared secret, used when no
# admin has signed in yet (e.g. before the first superadmin is seeded). Leave
# EMPTY in production — setting it means anyone hitting the console gets
# superadmin reads with no identity attached.
EYEGO_ADMIN_LEGACY_SECRET=

# Optional basemap for the fleet map (/map). Any MapLibre style URL, e.g. a
# MapTiler or Mapbox style with its key in the query string. Left unset, the map
# still plots every driver at its true position — you just get no streets behind
# them. Public by design: a style URL is fetched by the browser, so use a
# domain-restricted key.
NEXT_PUBLIC_MAP_STYLE_URL=
