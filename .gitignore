# Dependencies
**/node_modules/

# Expo / React Native build artifacts
.expo/
dist/
**/*/build/
**/*/dist/

# Generated native projects (expo prebuild) — scoped to each app's own
# top-level ios/android folder only, NOT **/ios/, which also matched (and
# silently dropped) hand-written native source under apps/*/modules/*/ios/
# and similar custom Expo module/target folders.
apps/*/ios/
apps/*/android/

# Env files (contain secrets)
.env
.env.local
.env*.local
apps/*/.env
apps/*/.env.local
apps/*/.env*.local

# Logs
*.log

# TypeScript
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# Prisma
**/prisma/dev.db
**/prisma/dev.db-journal

# EAS / Firebase / signing
google-service-account.json
GoogleService-Info.plist
google-services.json
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Sentry
sentry.properties

# Next.js (apps/admin)
.next/
next-env.d.ts
.vercel

# IDE
.idea/
*.swp
*.swo
*~

# Credentials for the local/VPS Postgres + Redis containers (docker-compose.yml).
.env.docker

# Database dumps. These contain real user data (names, phone numbers, trips)
# and must never reach the repository.
backups/
*.dump
eyego-api/.env.neon-backup

# ── Agent / tooling scratch ──────────────────────────────────────────────────
# Working directories for the various AI coding tools. They hold session state,
# caches and vendored copies of the repo, none of which is source.
.agent/
.codex/
.vibe/
.claude/worktrees/
graphify-out/

# A vendored second copy of the API tree. Committing it would put two versions
# of every backend file in the repo, and a grep or a build could pick the wrong
# one — see the SKIP_DIRS list in scripts/invariants.test.mjs.
eyego/

# ── Build artefacts ──────────────────────────────────────────────────────────
# Compiled apps. These are large binaries produced from the source that is
# already here, and GitHub rejects pushes over 100 MB.
*.apk
*.aab
*.ipa

# iOS crash reports captured while debugging sideloaded builds.
*.ips
