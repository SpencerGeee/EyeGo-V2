generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection (PgBouncer) — what the running server uses.
  url      = env("DATABASE_URL")
  // Direct connection — what `prisma migrate` uses.
  //
  // Neon (and every other PgBouncer-fronted Postgres) puts the pooler in
  // transaction mode, which cannot run the session-level statements a
  // migration needs — advisory locks, CREATE TYPE, ALTER TABLE in one
  // transaction. Without this split, `migrate dev` fails with a prepared
  // statement error that looks like a schema bug and is not one.
  //
  // DIRECT_URL must always be set. On a plain local Postgres with no pooler,
  // set it to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// TRIP LIFECYCLE — the canonical state machine
//
// There is exactly ONE authority for where a ride is in its life: Trip.status.
// Booking no longer carries lifecycle; it carries payment and seat concerns
// only. Every write to Trip.status goes through applyTransition() in
// src/services/trip-state.service.js — nothing else may touch it.
// ─────────────────────────────────────────

// Deliberately reuses the vocabulary already spoken across both apps
// (SCHEDULED / FILLING / CONFIRMED / DRIVER_EN_ROUTE / ARRIVED_AT_PICKUP /
// IN_PROGRESS / COMPLETED / CANCELLED / EXPIRED / NO_SHOW) rather than
// inventing synonyms, and adds only the states the old model could not
// express. Who cancelled is Trip.cancelledBy, not a separate status, so
// "cancelled" stays one concept everywhere.
enum TripStatus {
  // ── on-demand, pre-driver (these could not exist before: Trip required a driver)
  REQUESTED // rider asked; no driver yet. The Trip row exists from this moment.
  MATCHING // dispatch cascade is live, offers going out (was: DISPATCHING)
  // ── group / bus product, pre-departure
  SCHEDULED // seats open, departure in the future
  FILLING // seats being taken
  CONFIRMED // enough seats confirmed, waiting on departure time
  // ── driver attached
  DRIVER_ASSIGNED // a driver claimed it; hasn't started moving yet (was: MATCHED)
  REASSIGNING // driver dropped out; this same trip is going back to dispatch
  DRIVER_EN_ROUTE // driving to pickup
  ARRIVED_AT_PICKUP // at pickup, waiting for the rider
  IN_PROGRESS // rider on board, moving to dropoff
  // ── terminal (absorbing: applyTransition refuses every outbound edge)
  COMPLETED
  CANCELLED // see cancelledBy for RIDER | DRIVER | SYSTEM | ADMIN
  NO_DRIVERS_FOUND // cascade exhausted without a taker
  EXPIRED // nobody acted in time
  NO_SHOW
}

enum TripEventActor {
  RIDER
  DRIVER
  SYSTEM
  ADMIN
}

// Booking is now SEAT + MONEY only. It no longer carries trip lifecycle —
// "where is my ride" is answered by Trip.status and nowhere else. That split
// is the fix for the rider and the driver looking at two disagreeing rows.
enum BookingStatus {
  PENDING // created, seat not yet held
  SEAT_HELD // seat reserved pending payment
  CONFIRMED // seat is the rider's
  PAID
  BOARDED
  COMPLETED
  CANCELLED
  REFUNDED
  EXPIRED
  NO_SHOW
}

enum ScheduledTaskStatus {
  PENDING
  CLAIMED
  DONE
  FAILED
  CANCELLED
}

// ─────────────────────────────────────────
// USERS
// ─────────────────────────────────────────

model User {
  id            String       @id @default(cuid())
  phone         String       @unique
  email         String?      @unique
  name          String
  dob           String?
  profilePhoto  String?
  authProvider  String @default("PHONE")
  preferredTier String     @default("ECO")
  fcmToken              String?
  notificationPrefs     String?  // JSON blob: { driverArriving, tripStarted, ... }
  safetySettings        String?  // JSON blob: { shareTrip, rideCheck, speedAlerts, nightSafety }
  privacySettings       String?  // JSON blob: { shareData, personalizedAds, locationHistory }
  preferences           String?  // JSON blob: { theme } — mirrors Driver.preferences
  businessMode          Boolean  @default(false)
  businessCompanyName   String?
  businessTaxId         String?
  businessExpenseEmail  String?
  isActive      Boolean      @default(true)
  isBanned      Boolean      @default(false)
  walletBalancePesewas Int   @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  groupLed          RideGroup[]       @relation("LeadPassenger")
  ratings           DriverRating[]    @relation("UserRatings")
  passengerRatings  PassengerRating[] @relation("PassengerRatings")
  bookings          Booking[]
  invitations       Referral[]        @relation("Inviter")
  referredBy        Referral?         @relation("Invitee")
  supportTickets    SupportTicket[]
  referralsEarned   ReferralBonus[]
  receipts          Receipt[]
  emergencyContacts EmergencyContact[]
  savedCards            SavedCard[]
  scheduledRideIntents  ScheduledRideIntent[]
  tripRequests          TripRequest[]
  savedPlaces           SavedPlace[]
  requestedTrips        Trip[]            @relation("RequestedTrips")
}

model SavedPlace {
  id        String   @id @default(cuid())
  userId    String
  label     String
  address   String
  lat       Float
  lng       Float
  icon      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmergencyContact {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavedCard {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorizationCode String
  last4             String
  brand             String
  expMonth          String
  expYear           String
  cardholderName    String?
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@unique([userId, authorizationCode])
  @@index([userId])
}



// ─────────────────────────────────────────
// REFRESH TOKENS
// ─────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(cuid())
  tokenId   String   @unique
  userId    String?
  driverId  String?
  role      String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([driverId])
}

// ─────────────────────────────────────────
// DRIVERS
// ─────────────────────────────────────────

model Driver {
  id              String       @id @default(cuid())
  phone           String       @unique
  name            String
  profilePhoto    String?
  ghanaCardNumber String?
  ghanaCardPhoto  String?
  licensePhoto    String?
  // JSON: { DRIVERS_LICENSE?: { status: 'PENDING'|'VERIFIED'|'REJECTED', rejectionReason?, reviewedAt? }, GHANA_CARD?: {...}, PROFILE_PHOTO?: {...} }
  documentReview  String?
  dateOfBirth     String?
  status          String @default("PENDING_REVIEW")
  rejectionReason String?
  isOnline        Boolean      @default(false)
  currentLat      Float?
  currentLng      Float?
  currentHeading  Float?
  fcmToken        String?
  walletBalancePesewas Int     @default(0)
  payoutData      String?      // JSON: { type:'bank'|'momo', bankName?, accountNumber?, accountName?, network?, phone? }
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  vehicles        Vehicle[]
  trips           Trip[]
  ratings         DriverRating[]
  walletTxs       WalletTransaction[]
  shifts          DriverShift[]
  destinationPref DriverDestinationPreference?
  vehicleInspections VehicleInspection[]
  receipts            DriverReceipt[]
  dispatchActions     DispatchAction[]
  onlineSessions      OnlineSession[]
  emergencyContact    String?         // JSON: { name, phone, relationship }
  preferences         String?         // JSON: { emailNotifications, pushNotifications, ... }
}



// ─────────────────────────────────────────
// VEHICLES
// ─────────────────────────────────────────

model Vehicle {
  id            String   @id @default(cuid())
  driverId      String
  driver        Driver   @relation(fields: [driverId], references: [id])
  plateNumber   String   @unique
  make          String
  model         String
  year          Int
  seaterCount   Int
  tier          String
  frontPhoto    String?
  rearPhoto     String?
  interiorPhoto String?
  isVerified    Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  trips Trip[]
  inspections VehicleInspection[]
}



// ─────────────────────────────────────────
// ROUTES & VIRTUAL STOPS
// ─────────────────────────────────────────

model Route {
  id              String   @id @default(cuid())
  name            String
  originName      String
  destinationName String
  originLat       Float
  originLng       Float
  destLat         Float
  destLng         Float
  distanceKm      Float
  isActive        Boolean  @default(true)
  // True for a Route auto-created behind a driver's ad-hoc "create trip from
  // here" pickup or a rider's on-demand request — as opposed to the fixed,
  // admin-curated routes the old trotro-style booking flow depended on.
  // Keeps the admin route list from filling up with one-off, single-trip rows.
  isAdHoc         Boolean  @default(false)
  createdAt       DateTime @default(now())

  virtualStops          VirtualStop[]
  trips                 Trip[]
  pulseSchedules        PulseSchedule[]
  scheduledRideIntents  ScheduledRideIntent[]
}

model VirtualStop {
  id              String    @id @default(cuid())
  routeId         String
  route           Route     @relation(fields: [routeId], references: [id])
  name            String
  lat             Float
  lng             Float
  sequence        Int
  isActive        Boolean   @default(true)
  enRouteBookings Booking[]
}

// ─────────────────────────────────────────
// TRIPS
// ─────────────────────────────────────────

// The canonical ride. ONE row, both apps project it.
//
// On-demand ride  = routeId null, maxSeats 1, requesterId set, created at
//                   REQUESTED with driverId null.
// Group/bus trip  = routeId set, maxSeats > 1, created at SCHEDULED by a driver.
//
// driverId is nullable — that is the whole unlock. A ride can exist before a
// driver does, so a driver cancel redispatches THIS trip (same id, same
// receipt, same share link) instead of minting a new one.
model Trip {
  id              String     @id @default(cuid())
  shortId         String     @unique @default(cuid())
  driverId        String?
  driver          Driver?    @relation(fields: [driverId], references: [id])
  vehicleId       String?
  vehicle         Vehicle?   @relation(fields: [vehicleId], references: [id])
  routeId         String?
  route           Route?     @relation(fields: [routeId], references: [id])
  // Who asked for the ride. Null for driver-created group trips that nobody
  // has booked yet.
  requesterId     String?
  requester       User?      @relation("RequestedTrips", fields: [requesterId], references: [id])
  tier            String
  status          TripStatus @default(REQUESTED)
  // Monotonic. Bumped by applyTransition() on every status change and used as
  // the compare-and-swap guard, the TripEvent seq, and the client's
  // server-wins arbiter. Never decreases, never reused.
  version         Int        @default(0)
  doorstepPickup  Boolean    @default(false)
  pickupLat       Float?
  pickupLng       Float?
  pickupAddress   String?
  // Destination is a first-class property of the ride, not of a Route.
  dropoffLat      Float?
  dropoffLng      Float?
  dropoffAddress  String?
  departureTime   DateTime   @default(now())
  requestedAt     DateTime?
  assignedAt      DateTime?
  departedAt      DateTime?
  arrivedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelledBy     TripEventActor?
  cancellationReason String?
  baseFarePesewas  Int
  perKmRatePesewas Int
  // Dimensionless multipliers/ratios stay Float — they are not money and
  // rounding them to the pesewa would be wrong.
  surgeMultiplier Float      @default(1.0)
  commissionRate  Float      @default(0.15)
  confirmedSeats  Int        @default(0)
  maxSeats        Int
  isExpressMode   Boolean    @default(false)
  heavyLoad       Boolean    @default(false)
  // How many times this trip has been thrown back into dispatch after a
  // driver cancel. Bounded so a serially-cancelled ride terminates.
  redispatchCount Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  bookings        Booking[]
  events          TripEvent[]
  group           RideGroup?
  pulseScheduleId String?
  pulseSchedule   PulseSchedule? @relation(fields: [pulseScheduleId], references: [id])

  @@index([status])
  @@index([departureTime])
  @@index([driverId])
  @@index([routeId])
  @@index([requesterId, status])
  // Dispatch and the stuck-trip alarm both scan "live trips, oldest first".
  @@index([status, createdAt])
}

// Append-only. Never UPDATE, never DELETE.
//
// seq is the Trip.version the transition produced, so it is gap-free and
// strictly increasing per trip. It is what the realtime channel replays
// against: a client reconnects with lastSeq and gets everything above it.
model TripEvent {
  id        String         @id @default(cuid())
  tripId    String
  trip      Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seq       Int
  type      String         // usually the TripStatus reached; also non-status facts
  actor     TripEventActor
  actorId   String?
  payload   Json           @default("{}")
  createdAt DateTime       @default(now())

  @@unique([tripId, seq])
  @@index([tripId, seq])
}

// Durable timer / outbox table (Uber's LATE-table pattern).
//
// Rows are written INSIDE the same transaction as the state change that arms
// them, so a timer can never be armed for a transition that rolled back — and
// a deploy can never lose one, because it was never in process memory.
model ScheduledTask {
  id          String              @id @default(cuid())
  type        String              // OFFER_TIMEOUT | CASCADE_TICK | TRIP_EXPIRY | ...
  // Natural key for idempotency: at most one live task per (type, dedupeKey).
  dedupeKey   String
  tripId      String?
  runAt       DateTime
  payload     Json                @default("{}")
  status      ScheduledTaskStatus @default(PENDING)
  attempts    Int                 @default(0)
  claimedAt   DateTime?
  claimedBy   String?
  lastError   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([type, dedupeKey])
  // The poller's hot query: PENDING rows whose runAt has passed, oldest first.
  @@index([status, runAt])
  @@index([tripId])
}



// ─────────────────────────────────────────
// RIDE GROUPS
// ─────────────────────────────────────────

model RideGroup {
  id              String   @id @default(cuid())
  tripId          String   @unique
  trip            Trip     @relation(fields: [tripId], references: [id])
  leadPassengerId String
  leadPassenger   User     @relation("LeadPassenger", fields: [leadPassengerId], references: [id])
  shareToken      String   @unique @default(cuid())
  isCoverAll      Boolean  @default(false)
  expiresAt       DateTime
  createdAt       DateTime @default(now())
}

// ─────────────────────────────────────────
// BOOKINGS
// ─────────────────────────────────────────

model Booking {
  id                  String        @id @default(cuid())
  tripId              String
  trip                Trip          @relation(fields: [tripId], references: [id])
  userId              String?
  user                User?         @relation(fields: [userId], references: [id])
  seatNumber          Int?
  // ── MONEY IS INTEGER PESEWAS ────────────────────────────────────────────
  // 1 GHS = 100 pesewas. Every monetary column in this schema is `Int` and
  // named `…Pesewas`, without exception. See src/utils/money.js for why, and
  // for the only functions permitted to convert.
  //
  // The suffix is not decoration. Changing `fareAmount Float` (cedis) to
  // `fareAmount Int` (pesewas) in place would leave all ~120 read sites
  // compiling perfectly and quietly charging 100× too much. Renaming makes
  // every unconverted site a loud failure instead of a silent overcharge.
  fareAmountPesewas       Int
  commissionAmountPesewas Int
  paymentMethod       String
  paymentStatus       String @default("PENDING")
  paystackRef         String?
  guestName           String?
  guestPhone          String?
  isOffline           Boolean       @default(false)
  offlinePhone        String?
  offlineOtp          String?
  offlineOtpExp       DateTime?
  offlineOtpVerified  Boolean       @default(false)
  isCoveredByLead     Boolean       @default(false)
  boardingQr          String?
  promotionId         String?
  promotion           Promotion?    @relation(fields: [promotionId], references: [id])
  // Seat + money state ONLY. Lifecycle ("is the driver here yet") lives on
  // Trip.status. Do not add movement states here.
  status              BookingStatus @default(PENDING)
  cancelledAt         DateTime?
  cancellationReason  String?
  cancellationFeePesewas Int?
  pickupStopId        String?
  pickupStop          VirtualStop?  @relation(fields: [pickupStopId], references: [id])
  enRouteRatio        Float?
  // A group-hub joiner's own precise pickup point when it differs from the
  // trip's main pickup (e.g. friends booked via an invite link scattered
  // across town). Null means "board at the trip's own pickup" — the common
  // case, which is exactly the main booker's seat.
  pickupLat           Float?
  pickupLng           Float?
  pickupAddress       String?
  // Extra fare from the driver detouring to this passenger's own pickup
  // point, computed once at booking time — see fare.calculator.js
  // calculateDeviationSurcharge(). Zero for anyone boarding at the trip's
  // main pickup.
  deviationSurchargePesewas Int      @default(0)
  // Group-wide heavy-cargo/luggage surcharge, toggled by any member post-booking
  // (invite.tsx) — was previously a client-only UI toggle that changed the
  // displayed price but never actually charged anything.
  heavyCargo          Boolean       @default(false)
  // ── iOS Live Activity (ActivityKit) ──────────────────────────────────
  // Populated once the native Activity.pushTokenUpdates stream on the
  // rider's device yields a token — see POST /v1/trips/:id/live-activity-token.
  // Cleared when the activity ends (trip completes/cancels) so a stale
  // token can never be pushed to for a dead activity.
  liveActivityId        String?
  liveActivityPushToken String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  paymentTxs          PaymentTransaction[]
  receipts            Receipt[]

  @@unique([tripId, seatNumber])
  @@index([tripId])
  @@index([userId])
  @@index([status])
  @@index([paystackRef])
}

// ─────────────────────────────────────────
// CANCELLATION POLICY
// ─────────────────────────────────────────

model CancellationPolicy {
  id            String   @id @default(cuid())
  tier          String   @default("ECO")
  freeCancelMin Int      @default(60)  // Minutes before departure for free cancellation
  lateFeePct    Float    @default(50)  // Percentage charged for late cancellation
  noShowFeePct  Float    @default(100) // Percentage charged for no-show
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────────────────────
// RECEIPTS
// ─────────────────────────────────────────

model Receipt {
  id              String   @id @default(cuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id])
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  receiptNumber   String   @unique
  totalPaidPesewas       Int
  platformFeePesewas     Int
  driverEarningsPesewas  Int
  discountAppliedPesewas Int    @default(0)
  cancellationFeePesewas Int?
  paymentMethod   String
  paidAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([bookingId])
  @@index([userId])
  @@index([receiptNumber])
}

// ─────────────────────────────────────────
// DRIVER RECEIPTS (driver payout receipts)
// ─────────────────────────────────────────

model DriverReceipt {
  id              String   @id @default(cuid())
  driverId        String
  driver          Driver   @relation(fields: [driverId], references: [id])
  tripId          String?
  receiptNumber   String   @unique
  totalEarningsPesewas      Int
  commissionDeductedPesewas Int
  tipsReceivedPesewas       Int   @default(0)
  bonusAmountPesewas        Int   @default(0)
  periodStart     DateTime?
  periodEnd       DateTime?
  paidAt          DateTime?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())

  @@index([driverId])
}

// ─────────────────────────────────────────
// PAYMENT TRANSACTIONS
// ─────────────────────────────────────────

model PaymentTransaction {
  id              String   @id @default(cuid())
  bookingId       String?
  booking         Booking? @relation(fields: [bookingId], references: [id])
  userId          String?
  // Pesewas — which is also exactly what Paystack's `amount` field wants, so
  // this column and the gateway now speak the same unit with no conversion.
  amountPesewas   Int
  currency        String   @default("GHS")
  status          String
  paystackRef     String?
  gatewayResponse String?
  createdAt       DateTime @default(now())

  @@index([bookingId])
  @@index([paystackRef])
  @@index([userId])
}

// ─────────────────────────────────────────
// IDEMPOTENCY KEYS (safe payment retries)
// ─────────────────────────────────────────

model IdempotencyKey {
  id           String   @id @default(cuid())
  key          String
  userId       String
  endpoint     String
  statusCode   Int
  responseBody String
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([userId, endpoint, key])
  @@index([expiresAt])
}

// ─────────────────────────────────────────
// CALL SESSIONS (anonymized contact relay — Phase 3A)
// ─────────────────────────────────────────

model CallSession {
  id         String    @id @default(cuid())
  tripId     String
  bookingId  String?
  callerId   String
  calleeId   String
  relayToken String    @unique
  status     String    @default("INITIATED") // INITIATED | CONNECTED | ENDED
  endedAt    DateTime?
  createdAt  DateTime  @default(now())

  @@index([tripId])
}

// ─────────────────────────────────────────
// DRIVER QUESTS (growth / bonus system)
// ─────────────────────────────────────────

model DriverQuest {
  id            String                @id @default(cuid())
  title         String
  description   String
  type          String                // RIDES_COUNT | EARNINGS
  // The unit of `target` FOLLOWS `type`: a count of rides when RIDES_COUNT,
  // pesewas when EARNINGS. That ambiguity is inherent to one quest table
  // covering both, so it is stated here rather than left to be guessed —
  // read it through quests.service's `questUnit()`, never bare.
  target        Int                   // 10 (rides) | 20000 (pesewas = GH₵200)
  rewardAmountPesewas Int             // bonus credited on completion
  periodStart   DateTime
  periodEnd     DateTime
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())

  progress      DriverQuestProgress[]
}

model DriverQuestProgress {
  id          String      @id @default(cuid())
  questId     String
  quest       DriverQuest @relation(fields: [questId], references: [id])
  driverId    String
  // Same unit as the parent quest's `target` — see the note there.
  current     Int         @default(0)
  completed   Boolean     @default(false)
  rewardedAt  DateTime?
  updatedAt   DateTime    @updatedAt

  @@unique([questId, driverId])
  @@index([driverId])
}

// ─────────────────────────────────────────
// SCHEDULED RIDE INTENTS (rider-side future booking requests)
// ─────────────────────────────────────────

// ─────────────────────────────────────────
// TRIP REQUESTS (rider-initiated free-text destination dispatch to drivers)
// ─────────────────────────────────────────

model TripRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination String
  scheduledAt DateTime
  seatCount   Int      @default(1)
  // When seatCount > 1: true = requester pays for their whole party in one
  // bundled charge (auto-creates a RideGroup + books all seatCount seats
  // under them). false = requester books just their own seat and the
  // remaining seatCount-1 stay open on the matched trip for others to claim
  // via the RideGroup invite link (existing pay-individually flow).
  coverAll    Boolean  @default(true)
  pickupLat   Float?
  pickupLng   Float?
  destLat     Float?
  destLng     Float?
  matchedTripId String?
  status      String   @default("PENDING") // PENDING | DISPATCHED | ACCEPTED | EXPIRED | CANCELLED
  groupId     String?  // shared across grouped requests heading to same destination/time
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status, scheduledAt])
  @@index([groupId])
}

model ScheduledRideIntent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  routeId     String
  route       Route    @relation(fields: [routeId], references: [id])
  scheduledAt DateTime
  seatCount   Int      @default(1)
  status      String   @default("PENDING") // PENDING | DISPATCHED | MATCHED | CANCELLED | EXPIRED
  matchedTripId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([routeId, scheduledAt])
}

// ─────────────────────────────────────────
// PULSE SCHEDULES
// ─────────────────────────────────────────

model PulseSchedule {
  id            String   @id @default(cuid())
  routeId       String
  route         Route    @relation(fields: [routeId], references: [id])
  tier          String
  departureTime String
  daysOfWeek    String
  maxSeats      Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  trips Trip[]
}

// ─────────────────────────────────────────
// DRIVER WALLET TRANSACTIONS
// ─────────────────────────────────────────

model WalletTransaction {
  id            String       @id @default(cuid())
  driverId      String
  driver        Driver       @relation(fields: [driverId], references: [id])
  type          String
  // Signed: a debit is negative. `balanceAfter = balanceBefore + amount` is an
  // invariant the ledger asserts on every write (see wallet.service).
  amountPesewas        Int
  description   String
  balanceBeforePesewas Int
  balanceAfterPesewas  Int
  tripId        String?
  paystackRef   String?
  createdAt     DateTime     @default(now())

  @@index([driverId])
}

// ─────────────────────────────────────────
// DRIVER SHIFTS
// ─────────────────────────────────────────

model DriverShift {
  id          String    @id @default(cuid())
  driverId    String
  driver      Driver    @relation(fields: [driverId], references: [id])
  startTime   DateTime
  endTime     DateTime?
  earningsPesewas Int   @default(0)
  tripsCount  Int       @default(0)
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())

  @@index([driverId])
  @@index([driverId, startTime])
}

// ─────────────────────────────────────────
// DRIVER DESTINATION PREFERENCE
// ─────────────────────────────────────────

model DriverDestinationPreference {
  id          String   @id @default(cuid())
  driverId    String   @unique
  driver      Driver   @relation(fields: [driverId], references: [id])
  destLat     Float
  destLng     Float
  destName    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────
// VEHICLE INSPECTIONS
// ─────────────────────────────────────────

model VehicleInspection {
  id             String   @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id])
  driverId       String
  driver         Driver   @relation(fields: [driverId], references: [id])
  scheduledDate  DateTime
  completedDate  DateTime?
  status         String   @default("SCHEDULED")
  notes          String?
  inspectorName  String?
  result         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([vehicleId])
  @@index([driverId])
  @@index([scheduledDate])
}

// ─────────────────────────────────────────
// CHAT MESSAGES
// ─────────────────────────────────────────

model Message {
  id          String   @id @default(cuid())
  tripId      String
  senderId    String
  senderName  String?
  senderRole  String?          // 'DRIVER' | 'PASSENGER'
  seatNumber  Int?             // seat number of the passenger sender
  bookingId   String?          // booking that originated this message
  text        String
  isPrivate   Boolean  @default(false)
  recipientId String?          // for private threads: the other party's userId
  readAt      DateTime?        // when the recipient read this message
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([tripId])
  @@index([tripId, recipientId])
  @@index([senderId])
}



// ─────────────────────────────────────────
// DRIVER RATINGS
// ─────────────────────────────────────────

model DriverRating {
  id       String   @id @default(cuid())
  driverId String
  driver   Driver   @relation(fields: [driverId], references: [id])
  userId   String
  user     User     @relation("UserRatings", fields: [userId], references: [id])
  tripId   String
  stars    Int
  comment  String?
  createdAt DateTime @default(now())

  @@unique([userId, tripId])
  @@index([driverId])
}

// -----------------------------------------
// PASSENGER RATINGS (driver rates passenger)
// -----------------------------------------

model PassengerRating {
  id        String   @id @default(cuid())
  driverId  String
  userId    String
  user      User     @relation("PassengerRatings", fields: [userId], references: [id])
  tripId    String
  stars     Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([driverId, tripId, userId])
  @@index([driverId])
}

// -----------------------------------------
// PROMOTIONS
// -----------------------------------------

model Promotion {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int
  maxDiscountPesewas Int
  active          Boolean   @default(true)
  usageCount      Int       @default(0)
  maxRedemptions  Int?
  expiry          DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bookings        Booking[]
}

// -----------------------------------------
// REFERRALS
// -----------------------------------------

model Referral {
  id            String   @id @default(cuid())
  inviterId     String
  inviter       User     @relation("Inviter", fields: [inviterId], references: [id])
  inviteeId     String   @unique
  invitee       User     @relation("Invitee", fields: [inviteeId], references: [id])
  bonusClaimed  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bonuses       ReferralBonus[]

  @@index([inviterId])
}

// -----------------------------------------
// REFERRAL BONUSES
// -----------------------------------------

model ReferralBonus {
  id          String   @id @default(cuid())
  referralId  String
  referral    Referral @relation(fields: [referralId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amountPesewas Int
  type        String   @default("RIDER_CREDIT") // RIDER_CREDIT, DRIVER_BONUS
  status      String   @default("PENDING") // PENDING, CLAIMED, EXPIRED
  tripId      String?
  createdAt   DateTime @default(now())
  claimedAt   DateTime?

  @@index([referralId])
  @@index([userId])
}

// -----------------------------------------
// SUPPORT TICKETS
// -----------------------------------------

model SupportTicket {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  driverId    String?
  subject     String
  status      String   @default("OPEN")
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  category    String   @default("GENERAL") // GENERAL, PAYMENT, TRIP, ACCOUNT, TECHNICAL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    TicketMessage[]

  @@index([userId])
  @@index([driverId])
  @@index([status])
}

model TicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id])
  senderId    String
  senderRole  String   @default("USER")
  text        String
  attachment  String?
  createdAt   DateTime @default(now())

  @@index([ticketId])
}

// ─────────────────────────────────────────
// SOS EVENTS
// ─────────────────────────────────────────

model SosEvent {
  id         String    @id @default(cuid())
  tripId     String
  userId     String
  lat        Float?
  lng        Float?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tripId])
  @@index([userId])
}

// ─────────────────────────────────────────
// TRIP REPORTS (driver-submitted)
// ─────────────────────────────────────────

model TripReport {
  id         String     @id @default(cuid())
  tripId     String
  driverId   String
  type       String
  details    String?
  status     String     @default("OPEN")
  resolvedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([tripId])
  @@index([driverId])
}

// ─────────────────────────────────────────
// DISPATCH ACTIONS (accept/decline tracking)
// ─────────────────────────────────────────

model DispatchAction {
  id        String   @id @default(cuid())
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  tripId    String
  action    String   // ACCEPTED or DECLINED
  createdAt DateTime @default(now())

  @@index([driverId])
  @@index([tripId])
  @@index([driverId, createdAt])
}

// ─────────────────────────────────────────
// ONLINE SESSIONS (real online hour tracking)
// ─────────────────────────────────────────

model OnlineSession {
  id        String    @id @default(cuid())
  driverId  String
  driver    Driver    @relation(fields: [driverId], references: [id])
  startTime DateTime
  endTime   DateTime?
  createdAt DateTime  @default(now())

  @@index([driverId])
  @@index([driverId, startTime])
}
