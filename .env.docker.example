# Credentials for the Postgres and Redis containers in docker-compose.yml.
#
#   cp .env.docker.example .env.docker
#   # edit the two passwords, then:
#   docker compose --env-file .env.docker up -d
#
# .env.docker is gitignored. These are NOT the API's environment variables —
# the API reads eyego-api/.env, and the connection strings it needs are printed
# at the bottom of this file.

POSTGRES_USER=eyego
POSTGRES_PASSWORD=change-me-before-running
POSTGRES_DB=eyego

REDIS_PASSWORD=change-me-too

# Change these only if something else on the machine already owns the port.
POSTGRES_PORT=5432
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────────────────────
# What to put in eyego-api/.env once the containers are up
# ─────────────────────────────────────────────────────────────────────────────
#
# DATABASE_URL and DIRECT_URL are the SAME here, deliberately. The split exists
# because Neon fronts Postgres with a transaction-mode pooler that cannot run
# the session-level statements a migration needs. There is no pooler in front of
# this one, so both point at the same place — exactly as the note in
# prisma/schema.prisma describes.
#
#   DATABASE_URL="postgresql://eyego:YOUR_PASSWORD@127.0.0.1:5432/eyego"
#   DIRECT_URL="postgresql://eyego:YOUR_PASSWORD@127.0.0.1:5432/eyego"
#
# redis:// and not rediss:// — there is no network segment to encrypt on
# loopback. src/config/redis.js only insists on TLS for hosted hostnames
# (upstash.io, redislabs.com, elasticache), so this passes its check untouched.
#
#   REDIS_URL="redis://default:YOUR_REDIS_PASSWORD@127.0.0.1:6379"
#
# KEEP YOUR NEON AND UPSTASH URLS somewhere (commented out just below the new
# ones is fine). Nothing here deletes them, and being able to switch back by
# swapping three lines is worth more than a tidy file while you are still
# testing.
